    {"file":"19-react-application-structure.svg","title":"React 工作区的职责划分","subtitle":"路由、业务页面和基础组件各自承担清晰职责","nodes":[{"id":"route","x":30,"y":180,"title":"React Router","detail":"登录 · 队列 · 案件","tone":"navy"},{"id":"pages","x":250,"y":180,"title":"业务页面","detail":"查询 · 表单 · 工作流","tone":"teal"},{"id":"query","x":470,"y":180,"title":"Query 与 adapter","detail":"服务器状态 · API 策略","tone":"amber"},{"id":"ui","x":690,"y":180,"title":"shadcn/ui","detail":"表单 · 标签 · 对话框","tone":"purple"}],"edges":[{"from":"route","to":"pages"},{"from":"pages","to":"query"},{"from":"pages","to":"ui"}],"footer":"案件详情和 React Flow 图谱作为独立 chunk 延迟加载"},
    {"file":"20-react-state-boundaries.svg","title":"前端四类状态的边界","subtitle":"确认事实、输入草稿、界面交互和请求过程不要混在一起","nodes":[{"id":"server","x":30,"y":180,"title":"服务器状态","detail":"案件 · 交易 · 审计","tone":"navy"},{"id":"local","x":250,"y":180,"title":"组件状态","detail":"筛选 · 选项卡 · 对话框","tone":"purple"},{"id":"draft","x":470,"y":180,"title":"用户草稿","detail":"按账号与案件保存","tone":"amber"},{"id":"mutation","x":690,"y":180,"title":"Pending mutation","detail":"提交 · 错误 · 确认","tone":"teal"}],"edges":[{"from":"server","to":"local","label":"显示"},{"from":"draft","to":"mutation","label":"用户提交"},{"from":"mutation","to":"server","label":"成功后刷新","curve":65}],"footer":"迟到的服务器响应不能覆盖更新的本地输入"},
