    {"file":"01-system-boundary.svg","title":"RiskCase 的业务边界","subtitle":"告警进入调查流程；资金操作留在其他系统","nodes":[{"id":"up","x":45,"y":180,"title":"上游监测","detail":"发现模式 · 发送告警","tone":"amber"},{"id":"risk","x":360,"y":180,"title":"RiskCase","detail":"调查 · 协作 · 记录处置","tone":"teal"},{"id":"people","x":675,"y":180,"title":"分析员与主管","detail":"核实证据 · 独立复核","tone":"navy"}],"edges":[{"from":"up","to":"risk","label":"告警与引用"},{"from":"risk","to":"people","label":"调查工作项"}],"footer":"不执行付款 · 不改变余额 · 不冻结账户"},
