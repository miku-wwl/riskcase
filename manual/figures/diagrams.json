    {"file":"12-riskcase-aggregate.svg","title":"RiskCase 聚合与关联资料","subtitle":"案件聚合保护调查操作的一致性","nodes":[{"id":"alert","x":52,"y":88,"title":"RiskAlert","detail":"来源告警与风险信号","tone":"amber"},{"id":"notes","x":52,"y":286,"title":"调查笔记","detail":"分析员 · 时间 · 版本","tone":"navy"},{"id":"case","x":360,"y":188,"title":"RiskCase 聚合","detail":"状态 · 负责人 · 版本","tone":"teal"},{"id":"assessment","x":670,"y":88,"title":"RiskAssessment","detail":"等级 · 理由 · 时间","tone":"purple"},{"id":"decision","x":670,"y":286,"title":"RiskDecision","detail":"独立复核 · 处置","tone":"coral"}],"edges":[{"from":"alert","to":"case","label":"调查来源"},{"from":"case","to":"notes","label":"管理写入"},{"from":"case","to":"assessment","label":"当前评估"},{"from":"case","to":"decision","label":"终态记录"}],"footer":"Customer、Account 和 Transaction 是关联的调查证据，不全部装入案件聚合"},
