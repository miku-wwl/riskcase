    {"file":"05-case-lifecycle.svg","title":"案件生命周期","subtitle":"只能沿着领域规则允许的命令前进","nodes":[{"id":"new","x":34,"y":190,"title":"New","detail":"等待开始调查","tone":"navy"},{"id":"investigating","x":252,"y":190,"title":"Investigating","detail":"收集事实与评估","tone":"teal"},{"id":"reviewing","x":470,"y":190,"title":"Reviewing","detail":"独立人员复核","tone":"amber"},{"id":"resolved","x":688,"y":190,"title":"Resolved","detail":"决定已记录 · 只读","tone":"coral"}],"edges":[{"from":"new","to":"investigating","label":"开始"},{"from":"investigating","to":"reviewing","label":"提交复核"},{"from":"reviewing","to":"resolved","label":"记录处置"},{"from":"reviewing","to":"investigating","label":"显式退回","curve":72}],"footer":"复核可退回调查；结案后不能静默修改"},
